print(paste("Average number of flips:", avg_n_steps))
results |>
ggplot(aes(n_steps)) +
geom_density(fill="blue", alpha=0.25) +
theme_minimal()
get_bankruptcy_chance <- function(p){
results <- replicate(
2000, simulate_step(p, end0=10, end1=0), simplify = TRUE)
results <- data.frame(n_steps = results[1,], bankrupt = results[2,])
mean(results$bankrupt)
}
set.seed(42)
df <- data.frame(p = seq(0.3, 0.7, 0.01))
df <- df |> mutate(bankruptcy = sapply(p, get_bankruptcy_chance))
df |> ggplot(aes(p, bankruptcy)) +
geom_point() +
geom_line() +
xlab("p (probability of head)") +
ylab("Probability of bankruptcy") +
theme_minimal()
