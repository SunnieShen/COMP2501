n_step<-0
while(n_step<max_steps){
move<-sample(c("x+1","x-1","y+1","y-1"),1,
prob=c(0.25,0.25,0.25,0.25)
)
if(move=="x+1"){x<-x+1}
else if(move=="x-1"){x<-x-1}
else if(move=="y+1"){y<-y+1}
else{y<-y-1}
n_step<-n_step + 1
if(x==0 && y==0){return(n_step)}
}
return(Inf)
}
set.seed(42)
return_times<-replicate(n_simulation,simulate_random_walk_2D())
result_df <- data.frame(
return_time = return_times,
returned = return_times
)
result_df|> ggplot(aes(x = return_time)) +
stat_ecdf(geom = "step") +
coord_cartesian(xlim = c(0, 1e5)) +
labs(
title = "eCDF of number of steps needed to return to origin(2D)",
x = "Number of Steps")
simulate_random_walk_3D <- function(max_steps = 1e5){
x <- 0
y <- 0
z <- 0
n_step <- 0
while(n_step < max_steps){
move <- sample(c("x+1", "x-1", "y+1", "y-1", "z+1", "z-1"), 1)
if(move == "x+1"){x <- x + 1}
else if(move == "x-1"){x <- x - 1}
else if(move == "y+1"){y <- y + 1}
else if(move == "y-1"){y <- y - 1}
else if(move == "z+1"){z <- z + 1}
else {z <- z - 1}
n_step <- n_step + 1
if(x == 0 && y == 0 && z == 0){return(n_step)}
}
return(Inf)
}
set.seed(42)
return_times_3D <- replicate(n_simulation, simulate_random_walk_3D())
# Create result dataframe with successful returns
result_df_3D <- data.frame(return_time = return_times_3D)
result_df|> ggplot(aes(x = return_time)) +
stat_ecdf(geom = "step") +
coord_cartesian(xlim = c(0, 1e5)) +
labs(
title = "eCDF of number of steps needed to return to origin(2D)",
x = "Number of Steps")
