x <- cumsum(dx)
drunk_man_come_home <- function(max_steps=1e6){
dx <- sample(c(1, -1), size = max_steps, replace = TRUE)
x_movement <- cumsum(dx)
match(0, x_movement)
}
steps_took_to_come_home <- replicate(1000, drunk_man_come_home(1e6))
prob_home <- mean(!is.na(steps_took_to_come_home))
print(prob_home)
drunk_man_come_home_2d <- function(max_steps = 1e6) {
# 4 directions: 1=East, 2=West, 3=North, 4=South
step_dir <- sample(1:4, size = max_steps, replace = TRUE)
dx <- ifelse(step_dir %in% c(1,2), ifelse(step_dir == 1, 1, -1), 0)
dy <- ifelse(step_dir %in% c(3,4), ifelse(step_dir == 3, 1, -1), 0)
x <- cumsum(dx)
y <- cumsum(dy)
dist <- abs(x) + abs(y)
match(0, dist)
}
set.seed(42)
max_steps <- 1e6
n_rep <- 1000
n_steps <- replicate(n_rep, drunk_man_come_home_2d(max_steps))
get_ecdf <- function(threshold){
finished_by_threshold <- sum(n_steps < threshold, na.rm=TRUE)
finished_by_threshold / n_rep
}
ecdf_df <- data.frame(threshold=seq(1e3, 1e6, 1e3))
ecdf_df <- ecdf_df |>
mutate(ecdf=sapply(threshold, get_ecdf))
ecdf_df |>
ggplot(aes(threshold, ecdf)) +
geom_point() +
geom_line() +
xlab("Steps") +
ylab("eCDF") +
scale_x_log10() +  # Optional log scaling of x axis
theme_minimal()
dnorm(x, mean=0, sd=1)     # 正态分布密度函数
pnorm(q, mean=0, sd=1)     # 正态分布累积分布函数
?pnorm()
