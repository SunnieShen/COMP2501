slope_diff <- bootstrap_results$father_slope - bootstrap_results$mother_slope
#check whether 0 is in CI(95%)
CI_lower <- quantile(slope_diff, 0.025)
CI_upper <- quantile(slope_diff, 0.975)
CI_lower
CI_upper
six_head <- function(){
head <- sample(c(1,0), 10, prob = c(0.75,0.25), replace = TRUE)
return (as.integer(sum(head)==6))
}
mean(replicate(1e4, six_head()))
gamble<-function(prob_head=0.5,limit=10){
money_in_hand <-5
bankrupt<-0
flips<-0
while(TRUE){
money_in_hand <- money_in_hand + sample(c(1,-1),1,prob=c(prob_head,1-prob_head))
flips<-flips+1
if(money_in_hand==0){
bankrupt<-1
break
}
else if(money_in_hand==limit){
break
}
}
return(c(bankrupt,flips)) #returns a vector (col)
}
gamble_result<-replicate(1e4,gamble(0.5,50))
prob_bankrupt<-mean(gamble_result[1,])
avg_flips<-mean(gamble_result[2,])
prob_bankrupt
avg_flips
cons<-length(combinations(20,9))
df<-data.frame(p=seq(0,1,0.01))
df<-df|>mutate(
prior=dnorm(p, mean = 0.275, sd = 0.027),
likelihood = dbinom(9, size = 20, prob = p),
posterior = prior*likelihood
)
#approximate the area under the curve
total_area<-sum(df$posterior*0.01)
#normalization, s.t. area under curve is 1
df$posterior <- df$posterior/total_area
df|>ggplot(aes(p,posterior))+
geom_line()+
labs(x="p", y="probability density (posterior)")+
theme_minimal()
