# Load the package.
library(dplyr)
library(ggplot2)
library(HistData)
sample_from_biased_coin <- function(){
results <- sample(c(0, 1), 10, replace = TRUE, prob = c(0.25, 0.75))
sum(results) == 6
}
prob <- mean(replicate(10000, sample_from_biased_coin()))
print(prob)
simulate_step <- function(p, end1=0, end0=10){
cur <- 5
n_step <- 0
while (TRUE) {
flag <- sample(c(-1, 1), 1, prob = c(1-p, p))
cur <- cur + flag
n_step <- n_step + 1
if (cur == end1) {return(c(n_step, 1))}
if (cur == end0) {return(c(n_step, 0))}
}
}
set.seed(42)
results <- replicate(
10000, simulate_step(0.5, end0=10, end1=0), simplify = TRUE)
results <- data.frame(n_steps = results[1,], bankrupt = results[2,])
avg_loss <- mean(results$bankrupt)
avg_n_steps <- mean(results$n_steps)
print(paste("Probability of bankruptcy:", avg_loss))
print(paste("Average number of flips:", avg_n_steps))
