bankrupt<-0
flips<-0
while(TRUE){
money_in_hand <- money_in_hand + sample(c(1,-1),1,prob=c(prob_head,1-prob_head))
flips<-flips+1
if(money_in_hand==0){
bankrupt<-1
break
}
else if(money_in_hand==limit){
break
}
}
return(c(bankrupt,flips)) #returns a vector (col)
}
gamble_result<-replicate(1e4,gamble(0.5))
prob_bankrupt<-mean(gamble_result[1,])
avg_flips<-mean(gamble_result[2,])
prob_bankrupt
avg_flips
gamble_df<-data.frame(
bankrupt=gamble_result[1,],
flips=gamble_result[2,]
)
n_flip_plot<-gamble_df|>
ggplot(aes(flips))+
geom_histogram(binwidth = 1)
n_flip_plot
p<-seq(0.3,0.7,0.01)
estimate_bankrupt<-function(p,n_iter=1e4){
result<-replicate(n_iter,gamble(p))
mean(result[1,])
}
df<-data.frame(
prob=p,
prob_bankrupt=sapply(p,estimate_bankrupt)#sapply: function can only take one number, can not
)
df|>ggplot(aes(prob,prob_bankrupt))+
geom_smooth()
estimate_bankrupt_50<-function(p,n_iter=1e4){
result<-replicate(n_iter,gamble(p,50))
mean(result[1,])
}
df_50<-data.frame(
prob=p,
prob_bankrupt=sapply(p,estimate_bankrupt)#sapply: function can only take one number, can not take seq
)
df_50|>ggplot(aes(prob,prob_bankrupt))+
geom_smooth()
prior <- dnorm(df$p, mean = 0.275, sd = 0.027)
cons<-length(combinations(20,9))
library(gtools)
cons<-length(combinations(20,9))
cons<-length(combinations(20,9))
df<-data.frame(p=seq(0,1,0.01))
df<-df|>mutate(
prior=dnorm(p, mean = 0.275, sd = 0.027),
posterior = prior*cons*((1-p)**11)*p**9
)
#approximate the area under the curve
total_area<-sum(df$posterior*0.01)
#normalization, s.t. area under curve is 1
df$posterior <- df$posterior/total_area
df|>ggplot(aes(p,posterior))+
geom_line()+
labs(x="p", y="probability density (posterior)")+
theme_minimal()
install.packages("GaltonFamilies")
data("GaltonFamilies")
galton_heights <- GaltonFamilies|>
filter(gender=="female")|>
group_by(family) |>
sample_n(1) |>  # Sample one child per family
ungroup() |>
dplyr::select(father,mother, childHeight) |>
rename(daughter = childHeight)
mu_d<-galton_heights$daughter
mu_f<-galton_heights$father
mu_m<-galton_heights$mother
s_d<-sd(galton_heights$daughter)
s_f<-sd(galton_heights$father)
s_m<-sd(galton_heights$mother)
rho_f<-cor(galton_heights$father, galton_heights$daughter)
rho_m<-cor(galton_heights$mother, galton_heights$daughter)
slope_f<-rho_f* s_d/s_f
slope_m<-rho_m* s_d/s_m
cat("slope coefficients, daughter ~ father:", slope_f,"\n")
cat("slope coefficients, daughter ~ mother:", slope_m)
n_bootstrap <- 1000
n_original <- nrow(galton_heights)
sample_size <- n_original/2
set.seed(42)
for(i in 1:n_bootstrap) {
bootstrap_sample <- galton_heights[sample(1:n_original, sample_size, replace = TRUE), ]
# Calculate statistics of bootstrap sample
s_d_boot <- sd(bootstrap_sample$daughter)
s_f_boot <- sd(bootstrap_sample$father)
s_m_boot <- sd(bootstrap_sample$mother)
rho_f_boot <- cor(bootstrap_sample$father, bootstrap_sample$daughter)
rho_m_boot <- cor(bootstrap_sample$mother, bootstrap_sample$daughter)
bootstrap_slopes_father[i] <- rho_f_boot * s_d_boot / s_f_boot
bootstrap_slopes_mother[i] <- rho_m_boot * s_d_boot / s_m_boot
}
n_bootstrap <- 1000
n_original <- nrow(galton_heights)
sample_size <- n_original/2
bootstrap_slopes_father <- numeric(n_bootstrap)
bootstrap_slopes_mother <- numeric(n_bootstrap)
set.seed(42)
for(i in 1:n_bootstrap) {
bootstrap_sample <- galton_heights[sample(1:n_original, sample_size, replace = TRUE), ]
# Calculate statistics of bootstrap sample
s_d_boot <- sd(bootstrap_sample$daughter)
s_f_boot <- sd(bootstrap_sample$father)
s_m_boot <- sd(bootstrap_sample$mother)
rho_f_boot <- cor(bootstrap_sample$father, bootstrap_sample$daughter)
rho_m_boot <- cor(bootstrap_sample$mother, bootstrap_sample$daughter)
bootstrap_slopes_father[i] <- rho_f_boot * s_d_boot / s_f_boot
bootstrap_slopes_mother[i] <- rho_m_boot * s_d_boot / s_m_boot
}
bootstrap_results <- data.frame(
father_slope = bootstrap_slopes_father,
mother_slope = bootstrap_slopes_mother
)
bootstrap_results|>
pivot_longer(cols = everything(), names_to = "parent", values_to = "slope") |>
mutate(
parent = ifelse(parent == "father_slope", "Father", "Mother")) |>
ggplot(aes(x = slope, fill = parent)) +
geom_density(alpha = 0.6) +
labs(
title = "Bootstrap distributions of slope coefficients",
x = "Slope Coefficient"
)
