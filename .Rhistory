scale_y_continuous(labels=scales::percent) +
theme_minimal()
}
(Age_visualization+
Exploratory_visualization(survey_clean$Gender, "Gender")+
Exploratory_visualization(survey_clean$family_history, "family_history"))/
(Exploratory_visualization(survey_clean$work_interfere, "work_interfere")+
Exploratory_visualization(survey_clean$mental_care, "mental_care")+
Exploratory_visualization(survey_clean$tech_company, "tech_company"))
Age_summary<-survey_clean|>
group_by(Age)|>
summarise(
n_total = n(),
n_treatment = sum(treatment == "Yes", na.rm = TRUE),
prop_treatment = n_treatment / n_total,
.groups = "drop"
)|>
filter(n_total>=5)
Age_visualization<-ggplot(Age_summary , aes(x = Age, y = prop_treatment, size = n_total)) +
geom_point(alpha = 0.6) +
geom_smooth(alpha = 0.2)+
theme_minimal()+
theme(legend.position = "none")
Exploratory_visualization<-function(feature,feature_name){
ggplot(survey_clean, aes(x=feature, fill=treatment)) +
geom_bar(position="fill") +
labs(y="Proportion",x=feature_name) +
scale_y_continuous(labels=scales::percent) +
theme_minimal()
}
